    "label": "section-reasonable-decent",
    "source_math_index": 2,
    "target_math_index": 2,
    "source": "\\boxed{ \\begin{matrix} (\\alpha) & \\text{fibres of \\'etale morphisms from affines are finite} \\\\ (\\beta) & \\text{points come from monomorphisms of spectra of fields} \\\\ (\\gamma) & \\text{points come from quasi-compact monomorphisms of spectra of fields} \\\\ (\\delta) & \\text{fibres of \\'etale morphisms from affines are universally bounded} \\\\ (\\epsilon) & \\text{cover by \\'etale morphisms from schemes quasi-compact onto their image} \\end{matrix} }",
    "target": "\\boxed{ \\begin{matrix} (\\alpha) & \\text{les fibres des morphismes étales issus d'affines sont finies} \\\\ (\\beta) & \\text{les points proviennent de monomorphismes de spectres de corps} \\\\ (\\gamma) & \\text{les points proviennent de monomorphismes quasi-compacts de spectres de corps} \\\\ (\\delta) & \\text{les fibres des morphismes étales issus d'affines sont universellement bornées} \\\\ (\\epsilon) & \\text{recouvrement par des morphismes étales issus de schémas, quasi-compacts sur leur image} \\end{matrix} }",
    "record_id": "FR-DECENT-SPACES-MATH-TEXT-005",
    "review_status": "READ_RETAIN_EQUIVALENT_TRANSLATION",
    "source_math_sha256": "7DC46CF3C48A374704D60AEA43F9DA583E9A66839E7AB29987B1DA27DAD54619",
    "target_math_sha256": "9BCEC45B947F090B7C3E4D9D48118ED336DAC1D8448F127C086039683416CC9A",
    "reviewed_text_substitutions": [
      {
        "source": "\\text{fibres of \\'etale morphisms from affines are finite}",
        "target": "\\text{les fibres des morphismes étales issus d'affines sont finies}",
        "rationale_fr": "La finitude porte sur les fibres des morphismes étales de source affine, pas sur les morphismes eux-mêmes."
      },
      {
        "source": "\\text{points come from monomorphisms of spectra of fields}",
        "target": "\\text{les points proviennent de monomorphismes de spectres de corps}",
        "rationale_fr": "Le même critère de représentation des points par monomorphismes est conservé."
      },
      {
        "source": "\\text{points come from quasi-compact monomorphisms of spectra of fields}",
        "target": "\\text{les points proviennent de monomorphismes quasi-compacts de spectres de corps}",
        "rationale_fr": "La quasi-compacité qualifie les monomorphismes dans les deux langues ; elle n’est pas perdue."
      },
      {
        "source": "\\text{fibres of \\'etale morphisms from affines are universally bounded}",
        "target": "\\text{les fibres des morphismes étales issus d'affines sont universellement bornées}",
        "rationale_fr": "Le qualificatif universellement distingue ce critère de la simple finitude du premier."
      },
      {
        "source": "\\text{cover by \\'etale morphisms from schemes quasi-compact onto their image}",
        "target": "\\text{recouvrement par des morphismes étales issus de schémas, quasi-compacts sur leur image}",
        "rationale_fr": "Le recouvrement étale de source schématique et la quasi-compacité sur l’image sont conservés ensemble."
      }
    ],
    "external_attestation_for_every_word_claimed": false
  },
